{"id":"n5_u12_l1","unit_id":"n5_u12","instructional_level":"N5","title":"A mountain trip","goal":"Talk about a climb: the mountain, the summit, the seasons.","introduces":{"vocab":["v_fujisan","v_noborimasu","v_choujou","v_umi","v_kaze","v_fuyu","v_kisetsu"]},"explain":[{"heading":"Climbing words","body":["ふじさん (Mount Fuji), のぼります (climb), ちょうじょう (summit), うみ (sea), かぜ (wind), ふゆ (winter), きせつ (season)."],"examples":[{"ja":"なつ に ふじさん に のぼりました","reading":"natsu ni fujisan ni noborimashita","en":"I climbed Mount Fuji in the summer."}]}],"practice":{"question_ids":["q_n5u12_ty01","q_n5u12_ty02","q_n5u12_ty03","q_n5u12_ty04","q_n5u12_ty05","q_n5u12_ty06","q_n5u12_ty07","q_n5u12_dc01","q_n5u12_dc02","q_n5u12_dc03","q_n5u12_tr01","q_n5u12_tr02","q_n5u12_tr03","q_n5u12_tr04","q_n5u12_tr05","q_n5u12_tr06","q_n5u12_tr07","q_n5u12_tr08","q_n5u12_so01","q_n5u12_so02","q_n5u12_vm_fujisan","q_n5u12_vm_choujou","q_n5u12_vm_umi","q_n5u12_vm_kaze","q_n5u12_vm_fuyu","q_n5u12_vm_kisetsu"]},"exit_check":{"question_ids":["q_n5u12_ty01","q_n5u12_ty02","q_n5u12_ty04","q_n5u12_dc01","q_n5u12_tr01","q_n5u12_tr02","q_n5u12_tr03"],"pass":0.7},"provenance":"orig"},
