{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tabi-content",
  "$comment": "Schemas for every authored content file. IDs are stable ASCII slugs. content_status is NOT authored here: it lives in content/status.json and is materialised into bundles at build time.",
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9_]+$", "maxLength": 80 },
    "idList": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
    "level": { "enum": ["N5", "N4", "N3", "N2", "N1"] },
    "provenance": { "oneOf": [ { "type": "string", "pattern": "^[a-z0-9_]+$" }, { "type": "object", "required": ["origin", "author", "license"], "properties": { "origin": { "enum": ["original", "open_data", "official_reference_link_only"] }, "author": { "type": "string", "minLength": 1 }, "license": { "type": "string", "minLength": 1 }, "source_url": { "type": ["string", "null"] }, "retrieved_on": { "type": ["string", "null"] }, "attribution_text": { "type": ["string", "null"] } }, "additionalProperties": false } ] },
    "ruby": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } },
    "text": { "type": "string", "minLength": 1 },
    "common": { "type": "object", "required": ["id", "instructional_level", "unit_id", "provenance"] },

    "kana": { "type": "object", "required": ["id", "char", "script", "romaji", "row", "group", "unit_id", "order", "instructional_level"], "properties": { "id": { "$ref": "#/$defs/id" }, "char": { "$ref": "#/$defs/text" }, "script": { "enum": ["hiragana", "katakana"] }, "romaji": { "type": "string" }, "row": { "type": "string" }, "group": { "enum": ["basic", "dakuten", "handakuten", "youon", "extended", "sokuon", "long"] }, "unit_id": { "$ref": "#/$defs/id" }, "order": { "type": "integer" }, "similar_to": { "type": "array", "items": { "type": "string" } }, "instructional_level": { "$ref": "#/$defs/level" } }, "additionalProperties": false },

    "kanji": { "type": "object", "required": ["id", "char", "meanings_en", "on_readings", "kun_readings", "stroke_count", "unit_id", "instructional_level", "provenance", "example_word_ids"], "properties": { "id": { "$ref": "#/$defs/id" }, "char": { "type": "string", "minLength": 1, "maxLength": 1 }, "meanings_en": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/text" } }, "on_readings": { "type": "array", "items": { "type": "string" } }, "kun_readings": { "type": "array", "items": { "type": "string" } }, "reading_notes": { "type": "string" }, "stroke_count": { "type": "integer", "minimum": 1 }, "example_word_ids": { "$ref": "#/$defs/idList" }, "confusable_with": { "type": "array", "items": { "type": "string" } }, "unit_id": { "$ref": "#/$defs/id" }, "instructional_level": { "$ref": "#/$defs/level" }, "tags": { "type": "array", "items": { "type": "string" } }, "provenance": { "$ref": "#/$defs/provenance" } }, "additionalProperties": false },

    "vocab": { "type": "object", "required": ["id", "surface", "reading_kana", "romaji", "meanings_en", "pos", "unit_id", "instructional_level", "example_sentence_ids", "provenance"], "properties": { "id": { "$ref": "#/$defs/id" }, "surface": { "$ref": "#/$defs/text" }, "reading_kana": { "$ref": "#/$defs/text" }, "romaji": { "$ref": "#/$defs/text" }, "meanings_en": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/text" } }, "pos": { "type": "string", "minLength": 1 }, "unit_id": { "$ref": "#/$defs/id" }, "instructional_level": { "$ref": "#/$defs/level" }, "example_sentence_ids": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } }, "collocations": { "type": "array", "items": { "type": "string" } }, "related_ids": { "$ref": "#/$defs/idList" }, "register": { "type": ["string", "null"] }, "tags": { "type": "array", "items": { "type": "string" } }, "destination_tags": { "type": "array", "items": { "type": "string" } }, "listening_relevant": { "type": "boolean" }, "note": { "type": "string" }, "romaji_spoken": { "type": "string" }, "provenance": { "$ref": "#/$defs/provenance" } }, "additionalProperties": false },

    "grammar": { "type": "object", "required": ["id", "title", "pattern", "meaning_en", "explanation", "examples", "practice_question_ids", "unit_id", "instructional_level", "provenance"], "properties": { "id": { "$ref": "#/$defs/id" }, "title": { "$ref": "#/$defs/text" }, "pattern": { "$ref": "#/$defs/text" }, "meaning_en": { "$ref": "#/$defs/text" }, "explanation": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/text" } }, "structure_notes": { "type": "string" }, "examples": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/id" } }, "common_mistakes": { "type": "array", "items": { "type": "string" } }, "contrast_with": { "$ref": "#/$defs/idList" }, "practice_question_ids": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/id" } }, "register": { "type": "string" }, "unit_id": { "$ref": "#/$defs/id" }, "instructional_level": { "$ref": "#/$defs/level" }, "prerequisites": { "$ref": "#/$defs/idList" }, "tags": { "type": "array", "items": { "type": "string" } }, "provenance": { "$ref": "#/$defs/provenance" } }, "additionalProperties": false },

    "sentence": { "type": "object", "required": ["id", "kind", "text_ja", "reading_kana", "translation_en", "vocab_ids", "unit_id", "instructional_level", "naturalness", "provenance"], "properties": { "id": { "$ref": "#/$defs/id" }, "kind": { "enum": ["sentence", "phrase", "expression"] }, "text_ja": { "$ref": "#/$defs/text" }, "reading_kana": { "$ref": "#/$defs/text" }, "ruby": { "$ref": "#/$defs/ruby" }, "translation_en": { "$ref": "#/$defs/text" }, "vocab_ids": { "$ref": "#/$defs/idList" }, "grammar_ids": { "$ref": "#/$defs/idList" }, "kanji_used": { "type": "array", "items": { "type": "string" } }, "naturalness": { "enum": ["checked_auto", "needs_review", "human_ok"] }, "unit_id": { "$ref": "#/$defs/id" }, "instructional_level": { "$ref": "#/$defs/level" }, "tags": { "type": "array", "items": { "type": "string" } }, "provenance": { "$ref": "#/$defs/provenance" } }, "additionalProperties": false },

    "dialogue": { "type": "object", "required": ["id", "title", "setting", "turns", "comprehension_question_ids", "register", "unit_id", "instructional_level", "provenance"], "properties": { "id": { "$ref": "#/$defs/id" }, "title": { "$ref": "#/$defs/text" }, "setting": { "type": "string" }, "turns": { "type": "array", "minItems": 2, "items": { "type": "object", "required": ["speaker", "sentence_id"], "properties": { "speaker": { "type": "string" }, "sentence_id": { "$ref": "#/$defs/id" } }, "additionalProperties": false } }, "comprehension_question_ids": { "$ref": "#/$defs/idList" }, "register": { "type": "string" }, "unit_id": { "$ref": "#/$defs/id" }, "instructional_level": { "$ref": "#/$defs/level" }, "provenance": { "$ref": "#/$defs/provenance" } }, "additionalProperties": false },

    "passage": { "type": "object", "required": ["id", "title", "paragraphs", "translation_en", "word_count_chars", "question_ids", "genre", "unit_id", "instructional_level", "provenance"], "properties": { "id": { "$ref": "#/$defs/id" }, "title": { "$ref": "#/$defs/text" }, "paragraphs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/text" } }, "ruby": { "$ref": "#/$defs/ruby" }, "translation_en": { "$ref": "#/$defs/text" }, "word_count_chars": { "type": "integer", "minimum": 1 }, "question_ids": { "type": "array", "items": { "$ref": "#/$defs/id" } }, "genre": { "type": "string" }, "unit_id": { "$ref": "#/$defs/id" }, "instructional_level": { "$ref": "#/$defs/level" }, "provenance": { "$ref": "#/$defs/provenance" } }, "additionalProperties": false },

    "listening": { "type": "object", "required": ["id", "item_type", "script_turns", "audio_mode", "question_ids", "synthetic_audio_flag", "unit_id", "instructional_level", "provenance"], "properties": { "id": { "$ref": "#/$defs/id" }, "item_type": { "type": "string" }, "title": { "type": "string" }, "script_turns": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["speaker", "text_ja"], "properties": { "speaker": { "type": "string" }, "text_ja": { "$ref": "#/$defs/text" }, "reading_kana": { "type": "string" } }, "additionalProperties": false } }, "audio_mode": { "enum": ["tts", "asset"] }, "speaker_voice_hint": { "type": "array", "items": { "type": "string" } }, "question_ids": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } }, "synthetic_audio_flag": { "type": "boolean" }, "unit_id": { "$ref": "#/$defs/id" }, "instructional_level": { "$ref": "#/$defs/level" }, "provenance": { "$ref": "#/$defs/provenance" } }, "additionalProperties": false },

    "question": { "type": "object", "required": ["id", "type", "unit_id", "instructional_level", "stem", "answer", "explanation_correct", "facet", "targets", "difficulty", "provenance"], "properties": {
      "id": { "$ref": "#/$defs/id" },
      "type": { "enum": ["mcq", "matching", "kana_recog", "kana_recall", "flashcard", "fill_blank", "sentence_order", "construct", "translate", "error_correction", "reading_comp", "listening_comp", "dictation", "typing_ja", "handwriting_guided", "dialogue_complete", "context_vocab", "timed_quiz", "srs_review", "conversation_sim", "shadowing", "exam_style", "information_retrieval"] },
      "unit_id": { "$ref": "#/$defs/id" }, "instructional_level": { "$ref": "#/$defs/level" },
      "stem": { "type": "object", "required": ["prompt"], "properties": { "prompt": { "$ref": "#/$defs/text" }, "ja": { "type": ["string", "null"] }, "reading": { "type": ["string", "null"] }, "audio_text": { "type": ["string", "null"] }, "context_id": { "type": ["string", "null"] }, "context_ja": { "type": ["string", "null"] }, "ruby": { "$ref": "#/$defs/ruby" } }, "additionalProperties": false },
      "choices": { "type": ["array", "null"], "items": { "type": "object", "required": ["id", "text"], "properties": { "id": { "type": "string", "pattern": "^[a-z0-9_]+$" }, "text": { "type": "string", "minLength": 1 }, "ja": { "type": "boolean" }, "pos": { "type": "string" }, "concept": { "type": "string" } }, "additionalProperties": false } },
      "answer": { "oneOf": [ { "type": "string", "minLength": 1 }, { "type": "array", "minItems": 1, "items": { "type": "string" } } ] },
      "accept_alternatives": { "type": ["array", "null"], "items": { "type": "string" } },
      "tiles": { "type": "array", "items": { "type": "string" } },
      "pairs": { "type": "array", "items": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "string" } } },
      "steps": { "type": "array" },
      "explanation_correct": { "$ref": "#/$defs/text" },
      "explanation_per_distractor": { "type": ["object", "null"], "additionalProperties": { "type": "string" } },
      "facet": { "enum": ["read", "meaning", "produce", "listen", "construct"] },
      "targets": { "type": "array", "items": { "type": "string" } },
      "difficulty": { "type": "integer", "minimum": 1, "maximum": 5 },
      "jlpt_item_type": { "type": ["string", "null"] },
      "section": { "enum": ["vocabulary", "grammar", "reading", "listening", null] },
      "source_sentence_id": { "type": ["string", "null"] },
      "tags": { "type": "array", "items": { "type": "string" } },
      "provenance": { "$ref": "#/$defs/provenance" }
    }, "additionalProperties": false },

    "lesson": { "type": "object", "required": ["id", "unit_id", "title", "goal", "introduces", "explain", "practice", "exit_check", "instructional_level"], "properties": { "id": { "$ref": "#/$defs/id" }, "unit_id": { "$ref": "#/$defs/id" }, "instructional_level": { "$ref": "#/$defs/level" }, "title": { "$ref": "#/$defs/text" }, "goal": { "$ref": "#/$defs/text" }, "introduces": { "type": "object", "properties": { "kana": { "$ref": "#/$defs/idList" }, "vocab": { "$ref": "#/$defs/idList" }, "kanji": { "$ref": "#/$defs/idList" }, "grammar": { "$ref": "#/$defs/idList" } }, "additionalProperties": false }, "explain": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["heading", "body"], "properties": { "heading": { "$ref": "#/$defs/text" }, "body": { "type": "array", "items": { "type": "string" } }, "examples": { "type": "array", "items": { "type": "object", "required": ["ja", "en"], "properties": { "ja": { "type": "string" }, "reading": { "type": "string" }, "en": { "type": "string" } }, "additionalProperties": false } } }, "additionalProperties": false } }, "practice": { "$ref": "#/$defs/practiceSet" }, "context": { "$ref": "#/$defs/practiceSet" }, "exit_check": { "$ref": "#/$defs/practiceSet" }, "provenance": { "$ref": "#/$defs/provenance" } }, "additionalProperties": false },
    "practiceSet": { "type": "object", "properties": { "question_ids": { "$ref": "#/$defs/idList" }, "gen": { "type": "array", "items": { "type": "object", "required": ["type", "from", "n"], "properties": { "type": { "enum": ["kana_recog", "kana_recall", "matching", "vocab_meaning", "vocab_produce", "vocab_read", "flashcard", "kana_listen", "word_listen"] }, "from": { "enum": ["kana", "vocab"] }, "ids": { "$ref": "#/$defs/idList" }, "n": { "type": "integer", "minimum": 1 } }, "additionalProperties": false } }, "pass": { "type": "number", "minimum": 0, "maximum": 1 } }, "additionalProperties": false },

    "mock": { "type": "object", "required": ["id", "level", "title", "series", "sections", "created_on", "disclaimer_key", "provenance"], "properties": { "id": { "$ref": "#/$defs/id" }, "level": { "$ref": "#/$defs/level" }, "title": { "$ref": "#/$defs/text" }, "series": { "type": "string" }, "sections": { "type": "array", "minItems": 2, "items": { "type": "object", "required": ["id", "official_section_name", "minutes", "question_ids"], "properties": { "id": { "type": "string" }, "official_section_name": { "type": "string" }, "minutes": { "type": "integer", "minimum": 1 }, "question_ids": { "$ref": "#/$defs/idList" }, "shared_passages": { "type": "array", "items": { "type": "string" } }, "listening_ids": { "type": "array", "items": { "type": "string" } } }, "additionalProperties": false } }, "created_on": { "type": "string" }, "disclaimer_key": { "const": "practice_not_official" }, "provenance": { "$ref": "#/$defs/provenance" } }, "additionalProperties": false },

    "quest": { "type": "object", "required": ["id", "destination_id", "type", "question_ids", "min_accuracy", "unit_id", "provenance"], "properties": { "id": { "$ref": "#/$defs/id" }, "destination_id": { "$ref": "#/$defs/id" }, "tier": { "type": ["string", "null"] }, "type": { "type": "string" }, "question_ids": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } }, "spiral_question_ids": { "type": "array", "items": { "$ref": "#/$defs/id" } }, "min_accuracy": { "type": "number", "minimum": 0, "maximum": 1 }, "unit_id": { "$ref": "#/$defs/id" }, "provenance": { "$ref": "#/$defs/provenance" } }, "additionalProperties": false },

    "statusEntry": { "type": "object", "required": ["status"], "properties": { "status": { "enum": ["draft", "auto_checked", "human_reviewed"] }, "checked_on": { "type": "string" }, "review": { "type": "object", "properties": { "reviewer": { "type": ["string", "null"] }, "reviewed_on": { "type": ["string", "null"] }, "notes": { "type": ["string", "null"] } }, "additionalProperties": false } }, "additionalProperties": false }
  }
}
